<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - İLKFER_LİBRARY</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/İLKFER_LİBRARY.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="ilkfer-navbar">
            <div class="ilkfer-logo">
                <img src="/images/ilkfer_grup_logo.jpg" alt="İLKFER Group" />
            </div>

         
         
            <ul class="ilkfer-menu">

                <li>
                    <a asp-controller ="#">ANASAYFA</a>
                </li>

                <li>
                    <a asp-controller ="#">HAKKIMIZDA</a>
                </li>

                <li>
                    <a asp-controller="#">MÜZE</a>
                </li>

                <li>
                    <a asp-controller="#" class="active">KÜTÜPHANE</a>
                </li>

                <li>
                    <a asp-controller="#">SANAT</a>
                </li>

                <li>
                    <a asp-controller="#">ŞİRKETLER</a>
                </li>

                <li>
                    <a asp-controller="#">BİZE ULAŞIN</a>
                </li>

            </ul>

        </nav>
    </header>
    <a asp-controller="Library" asp-action="Koleksiyon" class="back-to-collection-btn">
        <span class="arrow">←</span> Koleksiyona Dön
    </a>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - İLKFER_LİBRARY - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)




</body>
</html>
