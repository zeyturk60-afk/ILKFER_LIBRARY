@{
    ViewData["Title"] = "Balkanlar ve Türklük";
}

<div class="book-detail-page">

    <div class="book-detail-container">

        <div class="book-detail-cover-wrap">

            <div class="book-detail-cover">
                <img src="/images/books/kitap_1.jpeg"
                     alt="Balkanlar ve Türklük" />
            </div>

            <div class="book-nav-buttons">

                <span class="book-nav-btn disabled" aria-disabled="true" >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 5l-7 7 7 7"/>
                    </svg>
                </span>

                <a class="book-nav-btn"
                   asp-controller="Library"
                   asp-action="TurkTarihi"
                   aria-label="Türk Tarihi kategorisine dön"
                   title="Türk Tarihi Kategorisine Dön">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 11.5L12 4l8 7.5"/>
                        <path d="M6 10v9a1 1 0 0 0 1 1h3v-5h4v5h3a1 1 0 0 0 1-1v-9"/>
                    </svg>
                </a>

                <a class="book-nav-btn"
                   asp-controller="Library"
                   asp-action="Kitap2"
                   aria-label="Sonraki kitap"
                   title="Sonraki Kitap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 5l7 7-7 7"/>
                    </svg>
                </a>

            </div>

        </div>

        <div class="book-detail-info">


            <h1>BALKANLAR VE TÜRKLÜK</h1>

            <div class="book-info-list">

                <p>
                    <strong>Yazar:</strong>
                 YAŞAR NABİ
                </p>

                <p>
                    <strong>Yayınevi:</strong>
                    Cumhuriyet Kitapları (Cumhuriyet Gazetesi Yayınları)
                </p>

                <p>
                    <strong>Basım Tarihi:</strong>
                    1999
                </p>


                <p>
                    <strong>Sayfa Sayısı:</strong>
                    112 Sayfa
                </p>

                <p>
                    <strong>Dil:</strong>
                    Türkçe
                </p>

                <p>
                 <strong>Konu:</strong>
                    Yedi Meşaleciler'den Yaşar Nabi Nayır'ın ilk baskısını 1936'da yaptığı bu gezi-inceleme eseri;  yazarın 1930'lu yıllarda Balkan Antantı ikliminde Balkan ülkelerine (Bulgaristan, Romanya,  Yugoslavya vb.) yaptığı seyahatlerdeki kişisel gözlem ve izlenimlerine dayanır. Eserde; Balkanlar'da yaşayan Türklerin sosyo-kültürel durumu, çektikleri zorluklar, maruz kaldıkları baskılar ve azınlık politikaları ele alınır. 
                </p>
            </div>

        </div>

    </div>



</div>

            
